# UiPath Orchestrator API credentials (External Application - Client Credentials)
# Copy this file to ".env" and fill in your real values. NEVER put real
# secrets in this file — it is a committed template.

# Multiple Orchestrator environments are configured as a single JSON array.
# Each object needs: client_code (the {clientcode} in the URL), environment
# (the {environment} in the URL), client_id, api_key, and an optional "name".
# The Jobs URL is derived as:
#   https://cloud.uipath.com/{client_code}/{environment}/orchestrator_/odata/Jobs
# Keep this on a single line. In production, inject the same variable from a
# secret manager (Azure Key Vault, AWS Secrets Manager, Doppler, ...).
ORCHESTRATOR_CLIENTS='[{"name":"Geisinger","client_code":"geisingerhs","environment":"Test","client_id":"REPLACE_ME","api_key":"REPLACE_ME"},{"name":"Acme","client_code":"acmehealth","environment":"Production","client_id":"REPLACE_ME","api_key":"REPLACE_ME"}]'

# --- Legacy single-client variables (still supported as a fallback) ---------
# If ORCHESTRATOR_CLIENTS is unset, the app builds one client from these plus
# the optional MONITOR_CLIENT_CODE (default "geisingerhs") and
# MONITOR_ENVIRONMENT (default "Test").
# ORCHESTRATOR_CLIENT_ID="REPLACE_ME"
# ORCHESTRATOR_API_KEY="REPLACE_ME"

# Supabase / Postgres connection string (Project Settings -> Database ->
# Connection string -> URI). Use the Session/Transaction Pooler URI for app
# connections. Leave unset to skip persistence during local development.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
